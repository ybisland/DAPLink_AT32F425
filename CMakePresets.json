{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "gpio",
            "inherits": "default",
            "cacheVariables": {
                "DAP_SWD_SPI": "0"
            }
        },
        {
            "name": "spi",
            "inherits": "default",
            "cacheVariables": {
                "DAP_SWD_SPI": "1"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gpio",
            "configurePreset": "gpio"
        },
        {
            "name": "spi",
            "configurePreset": "spi"
        }
    ]
}
